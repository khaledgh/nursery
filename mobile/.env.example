# Full API base URL, including the /api/v1 prefix.
# Leave unset to fall back to the Metro dev-server host on port 8080.
EXPO_PUBLIC_API_URL=https://ltc-api.linksbridge.top/api/v1

# OneSignal App ID (Settings > Keys & IDs in the OneSignal dashboard). This is
# the public app id, not the REST API key — the key belongs in backend/.env only.
EXPO_PUBLIC_ONESIGNAL_APP_ID=
