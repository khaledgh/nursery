{
  "name": "nursee-plus",
  "version": "1.0.1",
  "description": "Nursee+ Childcare Management Platform",
  "scripts": {
    "build:admin": "npm --prefix admin run build",
    "build:backend": "cd backend && go build -trimpath -ldflags \"-s -w\" -o api.exe ./cmd/api",
    "build": "npm --prefix admin run build && cd backend && go build -trimpath -ldflags \"-s -w\" -o api.exe ./cmd/api",
    "start": "cd backend && .\\api.exe",
    "dev": "npm --prefix admin run dev",
    "dev:backend": "cd backend && go run ./cmd/api",
    "dev:admin": "npm --prefix admin run dev"
  }
}
