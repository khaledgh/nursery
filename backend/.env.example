# App
APP_ENV=development            # development | production
APP_PORT=8080
APP_URL=http://localhost:8080
DEFAULT_LOCALE=en
# Comma-separated list of allowed browser origins (admin panel, etc.)
CORS_ORIGINS=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nursery
DB_USER=nursery
DB_PASSWORD=change-me

# Auth — generate with: openssl rand -base64 48  (min 32 chars enforced)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-please
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Initial admin (used by `make seed` only when the users table is empty)
SEED_ADMIN_EMAIL=admin@sunnystars.app
SEED_ADMIN_PASSWORD=

# Storage  (local | s3)
# "s3" also covers any S3-compatible provider, including Cloudflare R2.
#
# Media is never served from the bucket: the bucket stays PRIVATE and every
# object is streamed through /api/v1/media/stream/ behind a signed URL. Do not
# enable public access on the bucket — that would expose child photos and
# medical documents to anyone holding a link.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads

# Cloudflare R2 example:
#   S3_BUCKET=little-talent-media
#   S3_REGION=auto                                            # R2 wants the literal "auto"
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com # NOT the r2.dev public URL
#   S3_PATH_STYLE=true
# Credentials come from an R2 API token with Object Read & Write on this bucket.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_PATH_STYLE=true

# OneSignal
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Swish
SWISH_MERCHANT_ID=
SWISH_CERT_PATH=
SWISH_CALLBACK_URL=

# Integrations
WEATHER_API_KEY=
