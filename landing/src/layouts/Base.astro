---
import "../styles/global.css";
import { dirOf, getDict, localePath, locales, type Locale } from "../i18n";
import { site } from "../data/site";

interface Props {
  locale: Locale;
  /** Page path after the locale prefix, e.g. "privacy/". Empty for the home page. */
  path?: string;
  title?: string;
  description?: string;
  /** JSON-LD graph for this page. */
  schema?: object;
}

const { locale, path = "", title, description, schema } = Astro.props;
const t = getDict(locale);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const href = (l: Locale) => new URL(localePath(l) + path, site.url).toString();
const canonical = href(locale);
const ogImage = new URL("/og.png", site.url).toString();
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang={locale} dir={dirOf(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={t.meta.keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="author" content="Nursee+" />
    <meta name="application-name" content="Nursee+" />
    <meta name="apple-mobile-web-app-title" content="Nursee+" />
    <meta name="theme-color" content="#2CAFA8" />
    <meta name="geo.region" content="LB" />
    <meta name="geo.placename" content="Beirut, Lebanon" />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={href(l)} />)}
    <link rel="alternate" hreflang="x-default" href={href("en")} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nursee+" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={getDict(l).meta.ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href={locale === "ar"
        ? "https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Nunito:wght@700;800;900&display=swap"
        : "https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap"}
    />
    <link rel="preload" as="image" href="/mark.webp" />
  </head>
  <body class="overflow-x-hidden">
    <slot />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
