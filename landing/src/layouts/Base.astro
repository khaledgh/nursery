---
import "../styles/global.css";
import { dirOf, getDict, localePath, locales, type Locale } from "../i18n";
import { site } from "../data/site";

interface Props {
  locale: Locale;
  /** Page path after the locale prefix, e.g. "privacy/". Empty for the home page. */
  path?: string;
  title?: string;
  description?: string;
}

const { locale, path = "", title, description } = Astro.props;
const t = getDict(locale);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const href = (l: Locale) => new URL(localePath(l) + path, site.url).toString();
const canonical = href(locale);
---

<!doctype html>
<html lang={locale} dir={dirOf(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#2CAFA8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={href(l)} />)}
    <link rel="alternate" hreflang="x-default" href={href("en")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og-logo.png", site.url).toString()} />
    <meta property="og:locale" content={locale} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href={locale === "ar"
        ? "https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Nunito:wght@700;800;900&display=swap"
        : "https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap"}
    />
    <link rel="preload" as="image" href="/mark.webp" />
  </head>
  <body class="overflow-x-hidden">
    <slot />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
