---
import { site } from "../data/site";

interface Props {
  onDark?: boolean;
}
const { onDark = false } = Astro.props;

const stores = [
  {
    href: site.appStoreUrl,
    top: "Download on the",
    name: "App Store",
    path: "M16.37 12.63c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.7-3.19-1.72-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.88-.76-1.48.02-2.85.86-3.61 2.19-1.54 2.67-.39 6.62 1.11 8.79.73 1.06 1.61 2.25 2.75 2.2 1.1-.04 1.52-.71 2.86-.71 1.33 0 1.71.71 2.88.69 1.19-.02 1.94-1.08 2.67-2.15.84-1.23 1.19-2.42 1.21-2.48-.03-.01-2.32-.89-2.34-3.54zM14.2 6.17c.61-.74 1.02-1.76.91-2.78-.88.04-1.94.58-2.57 1.32-.56.65-1.06 1.69-.93 2.69.98.08 1.98-.5 2.59-1.23z",
  },
  {
    href: site.playStoreUrl,
    top: "Get it on",
    name: "Google Play",
    path: "M3.6 2.3c-.2.2-.3.6-.3 1v17.4c0 .4.1.8.3 1l9.7-9.7L3.6 2.3zm10.9 10.9 2.8 2.8-11.9 6.8c-.4.2-.8.2-1.1.1l10.2-9.7zm0-2.4L4.3 1.1c.3-.1.7-.1 1.1.1l11.9 6.8-2.8 2.8zm4 4.3-3-3 3-3 3.3 1.9c.9.5.9 1.9 0 2.4l-3.3 1.7z",
  },
];
const badge = `inline-flex items-center gap-2.5 rounded-2xl px-4 py-2.5 text-white shadow-lg transition-transform hover:-translate-y-0.5 ${
  onDark ? "bg-white/10 ring-1 ring-white/20" : "bg-ink"
}`;
---

<div class="flex flex-wrap gap-3" dir="ltr">
  {
    stores.map((s) =>
      s.href ? (
        <a href={s.href} target="_blank" rel="noopener" class={badge}>
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
            <path d={s.path} />
          </svg>
          <span class="text-start leading-tight">
            <span class="block text-[10px] font-semibold opacity-80">{s.top}</span>
            <span class="block text-base font-extrabold">{s.name}</span>
          </span>
        </a>
      ) : (
        <span class={badge}>
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
            <path d={s.path} />
          </svg>
          <span class="text-start leading-tight">
            <span class="block text-[10px] font-semibold opacity-80">{s.top}</span>
            <span class="block text-base font-extrabold">{s.name}</span>
          </span>
        </span>
      ),
    )
  }
</div>
