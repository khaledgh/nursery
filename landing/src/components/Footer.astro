---
import { Mail, Phone } from "lucide-react";
import StoreBadges from "./StoreBadges.astro";
import { site } from "../data/site";
import type { Dict, Locale } from "../i18n";
import { localePath } from "../i18n";
import { getLegal } from "../i18n/legal";

interface Props {
  t: Pick<Dict, "footer" | "nav">;
  locale: Locale;
}
const { t, locale } = Astro.props;
const home = localePath(locale);
const legal = getLegal(locale).links;
const year = new Date().getFullYear();
const socials = [
  { href: site.instagram, label: "Instagram", path: "M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2zm-.2 2A3.6 3.6 0 0 0 4 7.6v8.8A3.6 3.6 0 0 0 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6A3.6 3.6 0 0 0 16.4 4H7.6zm9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" },
  { href: site.facebook, label: "Facebook", path: "M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.5 1.6-1.5h1.7V4.4c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.3H7.4V14h2.7v8h3.4z" },
].filter((s) => s.href);
---

<footer class="relative overflow-hidden bg-ink pt-20 pb-10 text-white">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="glow glow-violet absolute -top-40 start-1/3 h-80 w-80"></div>
    <div class="glow glow-teal absolute -bottom-40 end-10 h-80 w-80"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div>
        <div class="inline-block rounded-3xl bg-white p-3">
          <img src="/logo.webp" alt="Nursee+" width="120" height="112" loading="lazy" class="h-20 w-auto" />
        </div>
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-white/70">{t.footer.tagline}</p>
        {
          socials.length > 0 && (
            <div class="mt-5 flex gap-2">
              {socials.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={s.label}
                  class="grid h-10 w-10 place-items-center rounded-full bg-white/10 transition-colors hover:bg-teal"
                >
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div>
        <h3 class="text-sm font-extrabold tracking-wider text-marigold uppercase">{t.footer.explore}</h3>
        <ul class="mt-4 space-y-2.5 text-sm font-semibold text-white/75">
          <li><a class="hover:text-white" href={`${home}#overview`}>{t.nav.overview}</a></li>
          <li><a class="hover:text-white" href={`${home}#features`}>{t.nav.features}</a></li>
          <li><a class="hover:text-white" href={`${home}#apps`}>{t.nav.apps}</a></li>
          <li><a class="hover:text-white" href={`${home}#pricing`}>{t.nav.pricing}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-extrabold tracking-wider text-marigold uppercase">{t.footer.company}</h3>
        <ul class="mt-4 space-y-2.5 text-sm font-semibold text-white/75">
          <li><button type="button" data-demo class="hover:text-white">{t.nav.demo}</button></li>
          <li><a class="hover:text-white" href={`${home}#contact`}>{t.nav.contact}</a></li>
          <li><a class="hover:text-white" href={site.adminUrl}>{t.nav.login}</a></li>
        </ul>
        {
          (site.email || site.phone) && (
            <ul class="mt-6 space-y-2.5 text-sm font-semibold text-white/75">
              {site.email && (
                <li>
                  <a class="flex items-center gap-2 hover:text-white" href={`mailto:${site.email}`}>
                    <Mail size={15} /> <span dir="ltr">{site.email}</span>
                  </a>
                </li>
              )}
              {site.phone && (
                <li>
                  <a class="flex items-center gap-2 hover:text-white" href={`tel:${site.phone}`}>
                    <Phone size={15} /> <span dir="ltr">{site.phone}</span>
                  </a>
                </li>
              )}
            </ul>
          )
        }
      </div>

      <div>
        <h3 class="text-sm font-extrabold tracking-wider text-marigold uppercase">{legal.legal}</h3>
        <ul class="mt-4 space-y-2.5 text-sm font-semibold text-white/75">
          <li><a class="hover:text-white" href={`${home}support/`}>{legal.support}</a></li>
          <li><a class="hover:text-white" href={`${home}privacy/`}>{legal.privacy}</a></li>
          <li><a class="hover:text-white" href={`${home}delete-account/`}>{legal.deleteAccount}</a></li>
        </ul>
        <div class="mt-6">
          <StoreBadges onDark />
        </div>
      </div>
    </div>

    <div class="mt-16 border-t border-white/10 pt-6 text-center text-xs font-semibold text-white/50">
      © {year} Nursee+. {t.footer.rights}
    </div>
  </div>
</footer>
