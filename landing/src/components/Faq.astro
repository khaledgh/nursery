---
import { ChevronDown } from "lucide-react";
import type { Dict } from "../i18n";
import { fillPrice } from "../lib/seo";

interface Props {
  t: Dict["faq"];
}
const { t } = Astro.props;
---

<section id="faq" class="relative overflow-hidden py-24 sm:py-28">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="glow glow-teal drift absolute top-20 -start-32 h-96 w-96"></div>
  </div>

  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="text-center">
      <span class="eyebrow" data-reveal>{t.eyebrow}</span>
      <h2 class="mt-4 text-3xl font-black text-ink sm:text-5xl" data-reveal style="--i:1">{t.title}</h2>
    </div>

    <div class="mt-12 space-y-3">
      {
        t.items.map((item, i) => (
          <details
            class="group rounded-2xl bg-white p-5 ring-1 ring-black/5 transition-shadow open:shadow-lg sm:p-6"
            data-reveal
            style={`--i:${i % 4}`}
            open={i === 0}
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-extrabold text-ink">
              <h3>{item.q}</h3>
              <ChevronDown size={20} class="shrink-0 text-teal transition-transform group-open:rotate-180" />
            </summary>
            <p class="mt-3 leading-relaxed text-muted">{fillPrice(item.a)}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
