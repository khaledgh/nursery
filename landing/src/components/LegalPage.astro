---
import { ArrowLeft, ChevronDown, Clock, Mail, MessageCircle, Phone, Trash2 } from "lucide-react";
import Base from "../layouts/Base.astro";
import DemoModal from "./DemoModal";
import Footer from "./Footer.astro";
import Navbar from "./Navbar";
import { site } from "../data/site";
import { getDict, localeNames, localePath, locales, type Locale } from "../i18n";
import { getLegal, type LegalPage, type Section } from "../i18n/legal";

interface Props {
  locale: Locale;
  page: LegalPage;
}

const { locale, page } = Astro.props;
const t = getDict(locale);
const legal = getLegal(locale);
const home = localePath(locale);
const path = `${page}/`;
// The language switcher stays on the same page in the other language.
const languages = locales.map((code) => ({ code, name: localeNames[code], href: localePath(code) + path }));
const fill = (text: string) => text.replaceAll("{email}", site.email);

const meta =
  page === "privacy" ? legal.privacy : page === "support" ? legal.support : legal.deletion;
const sections: Section[] =
  page === "privacy" ? legal.privacy.sections : page === "delete-account" ? legal.deletion.sections : [];
const intro: string[] =
  page === "privacy" ? legal.privacy.intro : page === "delete-account" ? legal.deletion.intro : [legal.support.intro];
const mailto = (subject: string) => `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
---

<Base locale={locale} path={path} title={`${meta.title} — Nursee+`} description={meta.description}>
  <Navbar client:load t={t.nav} locale={locale} adminUrl={site.adminUrl} languages={languages} home={home} />

  <main class="relative overflow-hidden pt-32 pb-24">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="glow glow-teal drift absolute -top-32 -start-24 h-96 w-96"></div>
      <div class="glow glow-violet drift absolute top-40 -end-32 h-96 w-96 [animation-delay:-6s]"></div>
      <span class="float-loop absolute top-36 end-[10%] text-3xl text-marigold">★</span>
    </div>

    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <a href={home} class="inline-flex items-center gap-1.5 text-sm font-bold text-teal-dark hover:text-teal" data-reveal>
        <ArrowLeft size={16} class="rtl:rotate-180" />
        {legal.backHome}
      </a>

      <header class="mt-6" data-reveal style="--i:1">
        <h1 class="text-4xl font-black text-ink sm:text-5xl">{meta.title}</h1>
        {page !== "support" && <p class="mt-3 text-sm font-bold text-muted">{legal.updated}</p>}
        <div class="mt-6 space-y-4 text-lg leading-relaxed text-ink/80">
          {intro.map((p) => <p>{fill(p)}</p>)}
        </div>
      </header>

      {
        page === "support" && (
          <>
            <section class="mt-10 rounded-[2rem] bg-white p-6 shadow-[0_20px_60px_-30px_rgba(30,41,59,0.35)] ring-1 ring-black/5 sm:p-8" data-reveal style="--i:2">
              <h2 class="text-2xl font-black text-ink">{legal.support.contactTitle}</h2>
              <p class="mt-2 text-muted">{legal.support.contactBody}</p>
              <div class="mt-6 flex flex-wrap gap-3">
                <a href={mailto("Nursee+ support")} class="btn-primary">
                  <Mail size={18} />
                  <span dir="ltr">{site.email}</span>
                </a>
                {site.phone && (
                  <a href={`tel:${site.phone}`} class="btn-ghost">
                    <Phone size={18} />
                    <span dir="ltr">{site.phone}</span>
                  </a>
                )}
                {site.whatsapp && (
                  <a href={`https://wa.me/${site.whatsapp.replace(/[^\d]/g, "")}`} target="_blank" rel="noopener" class="btn-ghost">
                    <MessageCircle size={18} />
                    WhatsApp
                  </a>
                )}
              </div>
              <p class="mt-4 flex items-center gap-2 text-sm font-bold text-muted">
                <Clock size={16} class="text-teal" />
                {legal.support.responseTime}
              </p>
            </section>

            <section class="mt-12">
              <h2 class="text-2xl font-black text-ink" data-reveal>{legal.support.faqTitle}</h2>
              <div class="mt-6 space-y-3">
                {legal.support.faq.map((item, i) => (
                  <details class="group rounded-2xl bg-white p-5 ring-1 ring-black/5 open:shadow-lg" data-reveal style={`--i:${i}`}>
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-extrabold text-ink">
                      {item.q}
                      <ChevronDown size={18} class="shrink-0 text-teal transition-transform group-open:rotate-180" />
                    </summary>
                    <p class="mt-3 leading-relaxed text-muted">{fill(item.a)}</p>
                  </details>
                ))}
              </div>
            </section>

            <section class="mt-12 flex flex-col items-center gap-4 rounded-[2rem] bg-gradient-to-br from-teal to-violet p-8 text-center text-white sm:flex-row sm:text-start" data-reveal>
              <img src="/mark.webp" alt="" width="72" height="80" loading="lazy" class="float-loop w-16" />
              <div class="flex-1">
                <h2 class="text-xl font-black">{legal.support.nurseryTitle}</h2>
                <p class="mt-1 text-white/85">{legal.support.nurseryBody}</p>
              </div>
              <button type="button" data-demo class="rounded-full bg-white px-6 py-3 font-extrabold text-violet-dark shadow-lg transition-transform hover:-translate-y-0.5">
                {t.nav.demo}
              </button>
            </section>

            <p class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm font-bold">
              <a class="text-teal-dark hover:underline" href={`${home}privacy/`}>{legal.links.privacy}</a>
              <a class="text-teal-dark hover:underline" href={`${home}delete-account/`}>{legal.links.deleteAccount}</a>
            </p>
          </>
        )
      }

      {
        sections.length > 0 && (
          <div class="mt-10 space-y-6">
            {sections.map((s) => (
              <section class="rounded-[1.75rem] bg-white p-6 ring-1 ring-black/5 sm:p-8" data-reveal>
                <h2 class="text-xl font-black text-ink">{s.h}</h2>
                {s.list && (
                  <ul class="mt-4 space-y-3">
                    {s.list.map((li) => (
                      <li class="flex gap-3 leading-relaxed text-ink/80">
                        <span class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-teal" aria-hidden="true" />
                        <span>{fill(li)}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {s.p?.map((p) => (
                  <p class="mt-4 leading-relaxed text-ink/80">{fill(p)}</p>
                ))}
              </section>
            ))}
          </div>
        )
      }

      {
        page === "delete-account" && (
          <div class="mt-8 text-center" data-reveal>
            <a href={mailto("Delete my account")} class="btn-primary">
              <Trash2 size={18} />
              {legal.deletion.button}
            </a>
          </div>
        )
      }

      {
        page === "privacy" && (
          <p class="mt-10 text-sm font-bold">
            <a class="text-teal-dark hover:underline" href={`${home}delete-account/`}>{legal.links.deleteAccount}</a>
            <span class="mx-3 text-muted">·</span>
            <a class="text-teal-dark hover:underline" href={`${home}support/`}>{legal.links.support}</a>
          </p>
        )
      }
    </div>
  </main>

  <Footer t={{ footer: t.footer, nav: t.nav }} locale={locale} />
  <DemoModal client:load t={t.form} ranges={t.ranges} locale={locale} />
</Base>
